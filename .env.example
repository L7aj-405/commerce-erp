# These defaults target a fresh LOCAL install (`composer setup` copies this
# file to .env). In Coolify, set APP_ENV=production, APP_DEBUG=false and the
# real APP_URL as environment variables there — never by editing this file.
APP_NAME="10xScale ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PRODUCT_NAME="10xScale ERP"
# MCP Streamable HTTP security boundary. APP_URL's host is accepted by
# default; list additional public hostnames explicitly (never use * in prod).
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
MCP_ALLOWED_ORIGINS=
MCP_RATE_LIMIT_PER_MINUTE=120
# Required before production legal publication / Google OAuth verification:
# APP_LEGAL_NAME=
# APP_LEGAL_CONTACT_EMAIL=
APP_LEGAL_LAST_UPDATED=2026-09-27

# Public self-registration (/register and Google sign-in for unknown emails).
# Defaults to OFF when APP_ENV=production (closed pilot) and ON elsewhere.
# The first pilot owner is created with `php artisan erp:bootstrap-owner`.
# PUBLIC_REGISTRATION_ENABLED=false

# Proxies trusted to set X-Forwarded-* headers (see DEPLOYMENT_CHECKLIST.md
# §16). Defaults to any private-range address (10/8, 172.16/12, 192.168/16)
# when unset, which fits Coolify's Traefik-in-front-of-the-app-container
# topology. Set to Traefik's exact IP/CIDR if the deployment can provide one.
# TRUSTED_PROXIES=

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production: use LOG_CHANNEL=daily, LOG_LEVEL=warning and retain a bounded
# number of files with LOG_DAILY_DAYS (or ship stderr to the platform logger).
LOG_DAILY_DAYS=14

# --- Database ---------------------------------------------------------------
# Production target is MySQL (multi-tenant schema, composite tenant foreign
# keys — see database/migrations/MIGRATION_BASELINE.md). Coolify will provide
# these as a linked MySQL service; do not point production at sqlite.
# DB_CONNECTION must be set explicitly (a missing value now targets mysql and
# fails loudly — never a silent SQLite file). Every MySQL session is pinned to
# UTC by config/database.php; run the MySQL server in UTC as well.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=commerce_erp
DB_USERNAME=
DB_PASSWORD=

# --- Session / cache / queue --------------------------------------------
# All three currently run on the "database" driver (sessions/cache/jobs
# tables are part of the base migrations) — no Redis dependency exists in the
# application today. See DEPLOYMENT_CHECKLIST.md before switching any of
# these to redis.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set SESSION_SECURE_COOKIE=true once the app is served over HTTPS in production.

CACHE_STORE=database
# CACHE_PREFIX=

QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=3900
# A supervised worker is REQUIRED in production (scheduled organization
# backups, Google Drive copies, WooCommerce sync, MCP product operations, queue
# heartbeat): `php artisan queue:work --tries=3 --timeout=3600` — the timeout
# must stay strictly below DB_QUEUE_RETRY_AFTER. See DEPLOYMENT_CHECKLIST.md.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# storage/app must be a PERSISTENT volume (/app/storage/app in Coolify): it
# holds logos and company stamps (app/public) AND stored organization backups
# plus pre-restore safety copies (app/private/organization-backups).
# `php artisan storage:link` must run on deploy. See DEPLOYMENT_CHECKLIST.md.

# --- Organization backup cryptography -----------------------------------
# Required in production. Generate two independent random 32-byte values and
# store them only in the deployment secret manager (base64:... is supported).
ORG_BACKUP_SIGNING_KEY=
ORG_BACKUP_ENCRYPTION_KEY=
ORG_BACKUP_KEY_ID=primary
# Emergency, time-bounded migration switch only. Unsigned v1 archives are
# rejected by default and should be re-exported in the authenticated v2 format.
ORG_BACKUP_ALLOW_LEGACY_UNSIGNED_RESTORE=false
ORG_BACKUP_TEMPORARY_FILE_TTL_HOURS=24
ORG_BACKUP_PRE_RESTORE_RETENTION_DAYS=30

MEMCACHED_HOST=127.0.0.1

# Redis is NOT used by the application (session, cache, locks, rate limits and
# queue all run on the database drivers). These Laravel defaults are inert.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail ---------------------------------------------------------------
# PLATFORM mail: account emails (email verification, password reset,
# invitations, security notices). MANDATORY in production — every user must
# verify their email before using the app. Use MAIL_MAILER=smtp with real
# credentials; "log" only writes emails to the log. Documents (Devis,
# Invoices, Delivery Notes) are NOT sent through this mailer: each
# organization configures its own SMTP in the app.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Integrations ---------------------------------------------------------
# WooCommerce: credentials (store URL, consumer key/secret) are entered and
# stored per Organization in the database (see App\Models\WooCommerceIntegration
# and the "Intégrations" settings page) — there is NO global env var for this.
#
# WhatsApp: used only as a "wa.me/<digits>" share link for sharing an issued
# document (App\Support\PhoneNumber::forWhatsApp). This is not an API
# integration and requires no token/credential.
#
# Shopify: not used by this application.
#
# PDF / documents (Dompdf): no extra environment variables — behaviour is
# controlled by config/documents.php (locale, paper size, remote-fetch toggle,
# share-link TTL). Dompdf ships its own fonts; no network access is required
# at PDF-render time.
