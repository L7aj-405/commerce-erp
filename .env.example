# These defaults target a fresh LOCAL install (`composer setup` copies this
# file to .env). In Coolify, set APP_ENV=production, APP_DEBUG=false and the
# real APP_URL as environment variables there — never by editing this file.
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ---------------------------------------------------------------
# Production target is MySQL (multi-tenant schema, composite tenant foreign
# keys — see database/migrations/MIGRATION_BASELINE.md). Coolify will provide
# these as a linked MySQL service; do not point production at sqlite.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=commerce_erp
DB_USERNAME=
DB_PASSWORD=

# --- Session / cache / queue --------------------------------------------
# All three currently run on the "database" driver (sessions/cache/jobs
# tables are part of the base migrations) — no Redis dependency exists in the
# application today. See DEPLOYMENT_CHECKLIST.md before switching any of
# these to redis.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set SESSION_SECURE_COOKIE=true once the app is served over HTTPS in production.

CACHE_STORE=database
# CACHE_PREFIX=

QUEUE_CONNECTION=database
# A queue worker process is required in production ONLY for the WooCommerce
# product/stock sync job (App\Jobs\SyncWooCommerceProductsJob). If no
# organization enables the WooCommerce integration, no worker is strictly
# necessary, but running one is still recommended so a future queued feature
# does not silently pile up unprocessed jobs.

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Local disk is fine as long as storage/app/public is a PERSISTENT volume
# across deployments (Document Profile logo uploads live there) and
# `php artisan storage:link` has been run once. See DEPLOYMENT_CHECKLIST.md.

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail ---------------------------------------------------------------
# Used to email issued Invoices, Devis (quotations) and Delivery Notes as PDF
# attachments (synchronous send, not queued). Production needs a real SMTP
# mailer (host/port/username/password) — "log" only writes emails to the log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Integrations ---------------------------------------------------------
# WooCommerce: credentials (store URL, consumer key/secret) are entered and
# stored per Organization in the database (see App\Models\WooCommerceIntegration
# and the "Intégrations" settings page) — there is NO global env var for this.
#
# WhatsApp: used only as a "wa.me/<digits>" share link for sharing an issued
# document (App\Support\PhoneNumber::forWhatsApp). This is not an API
# integration and requires no token/credential.
#
# Shopify: not used by this application.
#
# PDF / documents (Dompdf): no extra environment variables — behaviour is
# controlled by config/documents.php (locale, paper size, remote-fetch toggle,
# share-link TTL). Dompdf ships its own fonts; no network access is required
# at PDF-render time.
