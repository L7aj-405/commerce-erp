-- P03 leftovers of a partially applied run (MySQL DDL is not transactional)
SELECT 'P03a' AS id, 'New tables that already exist (expected 0)' AS check_name,
  IF(COUNT(*) = 0, 'PASS', 'STOP') AS result, COALESCE(GROUP_CONCAT(table_name SEPARATOR ', '), '-') AS detail
FROM information_schema.tables WHERE table_schema = DATABASE() AND table_name IN ('supplier_invoice_sequences', 'supplier_invoices', 'supplier_invoice_lines', 'supplier_invoice_installments', 'supplier_invoice_attachments', 'customer_opening_balances', 'customer_financial_terms', 'customer_credit_exceptions', 'customer_payment_installments', 'customer_payment_promises', 'customer_payment_instruments', 'customer_instrument_events', 'payment_allocation_releases', 'customer_opening_balance_settlements', 'parties', 'contact_roles', 'party_roles', 'party_relationships', 'payment_terms', 'party_migration_conflicts');

SELECT 'P03b' AS id, 'New columns that already exist (expected 0)' AS check_name,
  IF(COUNT(*) = 0, 'PASS', 'STOP') AS result, COALESCE(GROUP_CONCAT(CONCAT(table_name, '.', column_name) SEPARATOR ', '), '-') AS detail
FROM information_schema.columns WHERE table_schema = DATABASE() AND ((table_name = 'organizations' AND column_name IN ('invoice_issuance', 'credit_limit_enforcement', 'sales_order_payment_term_days', 'invoice_payment_term_days')) OR (table_name = 'suppliers' AND column_name IN ('ice', 'tax_identifier', 'rc_number', 'default_payment_term_days', 'default_currency_code', 'bank_iban', 'party_id', 'payment_term_id')) OR (table_name = 'finance_obligations' AND column_name IN ('supplier_invoice_installment_id')) OR (table_name = 'payments' AND column_name IN ('customer_id', 'request_fingerprint')) OR (table_name = 'payment_allocations' AND column_name IN ('effective_date')) OR (table_name = 'customers' AND column_name IN ('party_id')) OR (table_name = 'organization_contacts' AND column_name IN ('party_id')));

SELECT 'P03c' AS id, 'New CHECK constraints that already exist (expected 0)' AS check_name,
  IF(COUNT(*) = 0, 'PASS', 'STOP') AS result, COALESCE(GROUP_CONCAT(constraint_name SEPARATOR ', '), '-') AS detail
FROM information_schema.check_constraints WHERE constraint_schema = DATABASE()
  AND (constraint_name LIKE 'chk\_%');

SELECT 'P03d' AS id, 'Composite (organization_id, id) unique keys required by new foreign keys' AS check_name,
  IF(COUNT(*) = 7, 'PASS', 'STOP') AS result, CONCAT(COUNT(*), '/7: ', COALESCE(GROUP_CONCAT(table_name ORDER BY table_name SEPARATOR ', '), '-')) AS detail
FROM (SELECT DISTINCT table_name FROM (
        SELECT table_name, index_name, GROUP_CONCAT(column_name ORDER BY seq_in_index) AS cols, MAX(non_unique) AS nu
        FROM information_schema.statistics WHERE table_schema = DATABASE() AND table_name IN ('stores', 'suppliers', 'purchase_orders', 'purchase_order_lines', 'product_variants', 'tax_rates', 'financial_accounts')
        GROUP BY table_name, index_name) i WHERE nu = 0 AND cols = 'organization_id,id') k;

-- P04 financial CHECK constraints (2026_11_24_000001 refuses to run when any of these is non-zero)
SELECT 'P04.01' AS id, 'payments.amount must be > 0' AS check_name, IF(COUNT(*) = 0, 'PASS', 'STOP') AS result,
  CONCAT(COUNT(*), ' violating row(s); first ids: ', COALESCE(SUBSTRING_INDEX(GROUP_CONCAT(id ORDER BY id), ',', 20), '-')) AS detail
FROM payments WHERE NOT (amount > 0)
UNION ALL
SELECT 'P04.02' AS id, 'payment_allocations.amount must be > 0' AS check_name, IF(COUNT(*) = 0, 'PASS', 'STOP') AS result,
  CONCAT(COUNT(*), ' violating row(s); first ids: ', COALESCE(SUBSTRING_INDEX(GROUP_CONCAT(id ORDER BY id), ',', 20), '-')) AS detail
FROM payment_allocations WHERE NOT (amount > 0)
UNION ALL
SELECT 'P04.03' AS id, 'payment_refunds.amount must be > 0' AS check_name, IF(COUNT(*) = 0, 'PASS', 'STOP') AS result,
  CONCAT(COUNT(*), ' violating row(s); first ids: ', COALESCE(SUBSTRING_INDEX(GROUP_CONCAT(id ORDER BY id), ',', 20), '-')) AS detail
FROM payment_refunds WHERE NOT (amount > 0)
UNION ALL
SELECT 'P04.04' AS id, 'invoices.total_incl_tax must be >= 0' AS check_name, IF(COUNT(*) = 0, 'PASS', 'STOP') AS result,
  CONCAT(COUNT(*), ' violating row(s); first ids: ', COALESCE(SUBSTRING_INDEX(GROUP_CONCAT(id ORDER BY id), ',', 20), '-')) AS detail
FROM invoices WHERE NOT (total_incl_tax >= 0)
UNION ALL
SELECT 'P04.05' AS id, 'credit_notes.total_incl_tax must be >= 0' AS check_name, IF(COUNT(*) = 0, 'PASS', 'STOP') AS result,
  CONCAT(COUNT(*), ' violating row(s); first ids: ', COALESCE(SUBSTRING_INDEX(GROUP_CONCAT(id ORDER BY id), ',', 20), '-')) AS detail
FROM credit_notes WHERE NOT (total_incl_tax >= 0)
UNION ALL
SELECT 'P04.06' AS id, 'inventory_balances.on_hand must be >= 0' AS check_name, IF(COUNT(*) = 0, 'PASS', 'STOP') AS result,
  CONCAT(COUNT(*), ' violating row(s); first ids: ', COALESCE(SUBSTRING_INDEX(GROUP_CONCAT(id ORDER BY id), ',', 20), '-')) AS detail
FROM inventory_balances WHERE NOT (on_hand >= 0)
UNION ALL
SELECT 'P04.07' AS id, 'inventory_balances.reserved must be >= 0' AS check_name, IF(COUNT(*) = 0, 'PASS', 'STOP') AS result,
  CONCAT(COUNT(*), ' violating row(s); first ids: ', COALESCE(SUBSTRING_INDEX(GROUP_CONCAT(id ORDER BY id), ',', 20), '-')) AS detail
FROM inventory_balances WHERE NOT (reserved >= 0)
UNION ALL
SELECT 'P04.08' AS id, 'sandbox_payments.amount must be > 0' AS check_name, IF(COUNT(*) = 0, 'PASS', 'STOP') AS result,
  CONCAT(COUNT(*), ' violating row(s); first ids: ', COALESCE(SUBSTRING_INDEX(GROUP_CONCAT(id ORDER BY id), ',', 20), '-')) AS detail
FROM sandbox_payments WHERE NOT (amount > 0)
UNION ALL
SELECT 'P04.09' AS id, 'sandbox_payment_allocations.amount must be > 0' AS check_name, IF(COUNT(*) = 0, 'PASS', 'STOP') AS result,
  CONCAT(COUNT(*), ' violating row(s); first ids: ', COALESCE(SUBSTRING_INDEX(GROUP_CONCAT(id ORDER BY id), ',', 20), '-')) AS detail
FROM sandbox_payment_allocations WHERE NOT (amount > 0)
UNION ALL
SELECT 'P04.10' AS id, 'sandbox_payment_refunds.amount must be > 0' AS check_name, IF(COUNT(*) = 0, 'PASS', 'STOP') AS result,
  CONCAT(COUNT(*), ' violating row(s); first ids: ', COALESCE(SUBSTRING_INDEX(GROUP_CONCAT(id ORDER BY id), ',', 20), '-')) AS detail
FROM sandbox_payment_refunds WHERE NOT (amount > 0)
UNION ALL
SELECT 'P04.11' AS id, 'sandbox_inventory_balances.on_hand must be >= 0' AS check_name, IF(COUNT(*) = 0, 'PASS', 'STOP') AS result,
  CONCAT(COUNT(*), ' violating row(s); first ids: ', COALESCE(SUBSTRING_INDEX(GROUP_CONCAT(id ORDER BY id), ',', 20), '-')) AS detail
FROM sandbox_inventory_balances WHERE NOT (on_hand >= 0)
UNION ALL
SELECT 'P04.12' AS id, 'sandbox_inventory_balances.reserved must be >= 0' AS check_name, IF(COUNT(*) = 0, 'PASS', 'STOP') AS result,
  CONCAT(COUNT(*), ' violating row(s); first ids: ', COALESCE(SUBSTRING_INDEX(GROUP_CONCAT(id ORDER BY id), ',', 20), '-')) AS detail
FROM sandbox_inventory_balances WHERE NOT (reserved >= 0);

-- P05 permissions. 2026_11_28_000001 and 2026_12_02_000002 re-sync every role whose slug is a default slug
-- with the permissions of config/platform.php (additive, nothing is revoked).
SELECT 'P05a' AS id, 'Custom (non-system) roles reusing a default slug: they WOULD receive default permissions' AS check_name,
  IF(COUNT(*) = 0, 'PASS', 'REVIEW') AS result,
  COALESCE(GROUP_CONCAT(CONCAT('org ', organization_id, ' role ', id, ' (', slug, ')') SEPARATOR '; '), '-') AS detail
FROM roles WHERE is_system = 0 AND slug IN ('owner', 'admin', 'sales-employee');

