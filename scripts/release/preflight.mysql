-- =====================================================================================================
-- 10xScale ERP - production-consolidation-01 - PREFLIGHT (READ ONLY)
--
-- Run BEFORE any migration, against production or (first) an isolated clone:
--   mysql --table --default-character-set=utf8mb4 -h HOST -u USER -p DATABASE < scripts/release/preflight.mysql
--
-- Everything runs inside ONE `READ ONLY` transaction: MySQL itself refuses any write. Nothing is corrected.
-- Result column: PASS = ok | STOP = do not migrate | REVIEW = a human must read and accept | INFO = context.
-- Requires MySQL 8.0.19+ (VALUES ROW). Do not use --force: a SQL error must abort the run (treat as STOP).
-- Generated from main 5285c6c and the release tree; do not hand-edit lists.
-- =====================================================================================================
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
SET SESSION time_zone = '+00:00';
START TRANSACTION WITH CONSISTENT SNAPSHOT, READ ONLY;

-- P01 engine
SELECT 'P01' AS id, 'MySQL version (CHECK constraints need 8.0.16+; MariaDB is untested)' AS check_name,
  IF(VERSION() NOT LIKE '%MariaDB%' AND (CAST(SUBSTRING_INDEX(VERSION(),'.',1) AS UNSIGNED) > 8
     OR (CAST(SUBSTRING_INDEX(VERSION(),'.',1) AS UNSIGNED) = 8
         AND (CAST(SUBSTRING_INDEX(SUBSTRING_INDEX(VERSION(),'.',2),'.',-1) AS UNSIGNED) > 0
              OR CAST(SUBSTRING_INDEX(VERSION(),'.',-1) AS UNSIGNED) >= 19))), 'PASS', 'STOP') AS result,
  CONCAT('version=', VERSION(), ' sql_mode=', @@sql_mode, ' global_tz=', @@global.time_zone, ' system_tz=', @@system_time_zone,
         ' lock_wait_timeout=', @@lock_wait_timeout, 's') AS detail;

-- P02 migration state: production must be exactly at main (132 migrations), none of the 15 release migrations applied
SELECT 'P02a' AS id, 'Release migrations already recorded (expected 0)' AS check_name,
  IF(COUNT(*) = 0, 'PASS', 'STOP') AS result, COALESCE(GROUP_CONCAT(migration ORDER BY migration SEPARATOR ', '), '-') AS detail
FROM migrations WHERE migration IN ('2026_11_23_000001_provision_payments_refund_permission', '2026_11_23_000002_repair_payments_refund_catalog', '2026_11_24_000001_add_financial_check_constraints', '2026_11_25_000001_add_typed_policy_columns_to_organizations', '2026_11_25_000002_provision_policy_permissions', '2026_11_26_000001_add_fiscal_identity_to_suppliers', '2026_11_26_000002_create_supplier_invoice_tables', '2026_11_26_000003_link_obligations_to_supplier_invoice_installments', '2026_11_26_000004_provision_supplier_invoice_permissions', '2026_11_28_000001_create_customer_finance_tables', '2026_11_29_000001_add_customer_allocation_effective_dates', '2026_12_01_000001_add_invoicing_policy_to_customer_financial_terms', '2026_12_02_000001_create_unified_contacts_party_tables', '2026_12_02_000002_backfill_parties_and_provision_contact_permissions', '2026_12_03_000001_add_archive_snapshot_to_parties');

SELECT 'P02b' AS id, 'Applied migrations unknown to main (expected 0)' AS check_name,
  IF(COUNT(*) = 0, 'PASS', 'STOP') AS result, COALESCE(GROUP_CONCAT(migration ORDER BY migration SEPARATOR ', '), '-') AS detail
FROM migrations WHERE migration NOT IN ('0001_01_01_000000_create_users_table', '0001_01_01_000001_create_cache_table', '0001_01_01_000002_create_jobs_table', '2026_08_23_000001_create_platform_core_tables', '2026_08_23_000002_create_catalog_tables', '2026_08_23_000003_create_inventory_tables', '2026_08_23_000004_create_sales_tables', '2026_08_23_000005_create_payment_tables', '2026_08_23_000006_create_document_tables', '2026_08_23_000007_create_product_import_tables', '2026_08_23_000008_create_stock_transfer_tables', '2026_08_23_000009_create_woocommerce_integration_tables', '2026_08_23_000010_provision_permissions', '2026_09_09_000001_recreate_invoice_sequences_with_year', '2026_09_09_000002_add_av_professional_fields_to_invoices', '2026_09_10_000001_add_correction_workflow_to_invoices', '2026_09_11_000001_create_quotation_tables', '2026_09_11_000002_provision_quotation_permissions', '2026_09_12_000001_add_revision_workflow_to_quotations', '2026_09_13_000001_add_tax_unresolved_to_sales_order_lines', '2026_09_14_000001_create_transfer_request_tables', '2026_09_14_000002_create_warehouse_replenishment_tables', '2026_09_14_000003_provision_transfer_request_permissions', '2026_09_15_000001_add_driver_and_shipping_details_to_transfer_requests', '2026_09_16_000001_create_supplier_procurement_tables', '2026_09_16_000002_provision_procurement_permissions', '2026_09_16_000003_add_preset_slug_to_roles_table', '2026_09_16_000004_provision_finance_and_settings_permissions', '2026_09_16_000005_create_user_invitations_table', '2026_09_17_000001_add_accepted_methods_to_financial_accounts_table', '2026_09_17_000002_create_organization_mail_settings_table', '2026_09_18_000001_create_organization_document_stamp_tables', '2026_09_18_000002_provision_document_stamp_permission', '2026_09_19_000001_add_rotation_to_document_stamp_tables', '2026_09_20_000001_create_woocommerce_stock_tasks_table', '2026_09_20_000002_provision_woocommerce_stock_task_permissions', '2026_09_20_000003_create_