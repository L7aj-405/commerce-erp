'2026_11_05_000002_provision_quotation_sourcing_permissions', '2026_11_06_000001_create_purchase_orders_tables', '2026_11_07_000001_create_procurement_receipts_table', '2026_11_08_000001_create_product_variant_suppliers_table', '2026_11_08_000002_provision_supplier_catalog_permission', '2026_11_09_000001_create_fulfillment_tables', '2026_11_09_000002_provision_fulfillment_permissions', '2026_11_10_000001_add_shipment_tracking_and_customer_notifications', '2026_11_11_000001_add_shipment_context_to_follow_ups', '2026_11_12_000001_add_cart_sourcing_to_supplier_availability_requests', '2026_11_13_000001_add_progress_and_diagnostics_to_woocommerce_sync_runs', '2026_11_14_000001_add_pos_terminals_and_store_inventory_locations', '2026_11_15_000001_add_editing_and_restoration_to_transfer_requests', '2026_11_16_000001_add_reallocated_quantity_to_transfer_request_lines', '2026_11_17_000001_widen_purchase_orders_status_column', '2026_11_18_000001_add_pos_fulfillment_origin_to_sales_orders', '2026_11_21_000001_create_sandbox_foundation', '2026_11_21_000002_isolate_sandbox_sales', '2026_11_21_000003_isolate_sandbox_documents', '2026_11_21_000004_create_sandbox_inventory', '2026_11_21_000005_create_sandbox_finance', '2026_11_21_000006_create_sandbox_procurement', '2026_11_21_000007_create_sandbox_fulfillment', '2026_11_21_000008_isolate_sandbox_returns', '2026_11_22_000001_add_fiscal_protection_to_organizations', '2026_11_22_000001_add_pos_last_activity_to_sales_orders', '2026_11_22_000002_add_client_operation_to_stock_transfers') AND migration NOT IN ('2026_11_23_000001_provision_payments_refund_permission', '2026_11_23_000002_repair_payments_refund_catalog', '2026_11_24_000001_add_financial_check_constraints', '2026_11_25_000001_add_typed_policy_columns_to_organizations', '2026_11_25_000002_provision_policy_permissions', '2026_11_26_000001_add_fiscal_identity_to_suppliers', '2026_11_26_000002_create_supplier_invoice_tables', '2026_11_26_000003_link_obligations_to_supplier_invoi