      ROW('sales-employee', 'delivery_notes.update_draft'),
      ROW('sales-employee', 'delivery_notes.issue'),
      ROW('sales-employee', 'delivery_notes.email')) AS t (slug, k)
JOIN roles r ON r.slug = t.slug
WHERE NOT EXISTS (SELECT 1 FROM role_permission rp JOIN permissions p ON p.id = rp.permission_id
                  WHERE rp.role_id = r.id AND p.`key` = t.k);

SELECT 'P05c' AS id, 'New permissions each default role will receive' AS check_name, 'REVIEW' AS result,
  CONCAT(r.slug, ' (', COUNT(DISTINCT r.id), ' role(s)): ', GROUP_CONCAT(DISTINCT t.k ORDER BY t.k SEPARATOR ', ')) AS detail
FROM (VALUES
      ROW('owner', 'settings.billing.manage'),
      ROW('owner', 'customers.manage_credit'),
      ROW('owner', 'contacts.roles.manage'),
      ROW('owner', 'contacts.payment_terms.manage'),
      ROW('owner', 'payments.refund'),
