      ROW('owner', 'finance.customers.settlements.manage'),
      ROW('owner', 'finance.customers.schedules.manage'),
      ROW('owner', 'finance.customers.instruments.manage'),
      ROW('admin', 'settings.billing.manage'),
      ROW('admin', 'customers.manage_credit'),
      ROW('admin', 'supplier_invoices.view'),
      ROW('admin', 'supplier_invoices.manage'),
      ROW('admin', 'contacts.roles.manage'),
      ROW('admin', 'contacts.payment_terms.manage'),
      ROW('admin', 'payments.refund'),
      ROW('admin', 'supplier_invoices.approve'),
      ROW('admin', 'supplier_invoices.void'),
      ROW('admin', 'finance.customers.opening_balance.manage'),
      ROW('admin', 'finance.customers.terms.manage'),
      ROW('admin', 'finance.customers.credit_override'),
      ROW('admin', 'finance.customers.settlements.manage'),
      ROW('admin', 'finance.customers.schedules.manage'),
      ROW('admin', 'finance.customers.instruments.manage'),
      ROW('sales-employee', 'supplier_invoices.view'),
      ROW('sales-employee', 'supplier_invoices.manage')) AS t (slug, k)
JOIN roles r ON r.slug = t.slug
GROUP BY r.slug;

SELECT 'P05d' AS id, 'Roles receiving equivalence grants (custom roles included)' AS check_name, 'REVIEW' AS result,
  CONCAT('org ', r.organization_id, ' role ', r.id, ' ', r.slug, IF(r.is_system, ' [system]', ' [custom]'), ' holds: ',
         GROUP_CONCAT(p.`key` ORDER BY p.`key` SEPARATOR ', '),
         ' => gains: ',
         CONCAT_WS(', ',
           IF(SUM(p.`key` = 'payments.reverse') > 0, 'payments.refund', NULL),
           IF(SUM(p.`key` = 'settings.update') > 0, 'settings.billing.manage, customers.manage_credit', NULL),
           IF(SUM(p.`key` IN ('procurement.manage', 'finance.monthly_situation.manage')) > 0, 'supplier_invoices.view/manage', NULL),
           IF(SUM(p.`key` = 'finance.monthly_situation.manage') > 0, 'supplier_invoices.approve/void', NULL))) AS detail
FROM roles r JOIN role_permission rp ON rp.role_id = r.id JOIN permissions p ON p.id = rp.permission_id
WHERE p.`key` IN ('payments.reverse', 'settings.update', 'procurement.manage', 'finance.monthly_situation.manage')
GROUP BY r.id, r.organization_id, r.slug, r.is_system ORDER BY r.organization_id, r.id;

SELECT 'P05e' AS id, 'Release permission keys already present (expected 0 on a main database)' AS check_name,
  IF(COUNT(*) = 0, 'PASS', 'REVIEW') AS result, COALESCE(GROUP_CONCAT(`key` SEPARATOR ', '), '-') AS detail
FROM permissions WHERE `key` IN ('settings.billing.manage', 'customers.manage_credit', 'contacts.roles.manage', 'contacts.payment_terms.manage', 'payments.refund', 'supplier_invoices.view', 'supplier_invoices.manage', 'supplier_invoices.approve', 'supplier_invoices.void', 'finance.customers.opening_balance.manage', 'finance.customers.terms.manage', 'finance.customers.credit_override', 'finance.customers.settlements.manage', 'finance.customers.schedules.manage', 'finance.customers.instruments.manage');

-- P06 Unified Contacts backfill (2026_12_02_000002). Additive: only the new nullable party_id is written on legacy rows.
-- suppliers.ice is a NEW column, so at migration time it is empty: NO customer/supplier pair is merged by ICE.
SELECT 'P06a' AS id, 'Rows that will each get a party (per organization)' AS check_name, 'INFO' AS result,
  CONCAT('org ', o.id, ': customers=', (SELECT COUNT(*) FROM customers c WHERE c.organization_id = o.id),
         ' suppliers=', (SELECT COUNT(*) FROM suppliers s WHERE s.organization_id = o.id),
         ' contacts=', (SELECT COUNT(*) FROM organization_contacts k WHERE k.organization_id = o.id)) AS detail
FROM organizations o ORDER BY o.id;

SELECT 'P06b' AS id, 'Customer type values (anything but company is migrated as a person)' AS check_name,
  IF(type IN ('company', 'individual'), 'INFO', 'REVIEW') AS result, CONCAT(type, ' / ', status, ': ', COUNT(*)) AS detail
FROM customers GROUP BY type, status;

SELECT 'P06c' AS id, 'Contacts linked to a customer of ANOTHER organization (link ignored by the backfill)' AS check_name,
  IF(COUNT(*) = 0, 'PASS', 'REVIEW') AS result, CONCAT(COUNT(*), ' contact(s)') AS detail
FROM organization_contacts k JOIN customers c ON c.id = k.customer_id WHERE c.organization_id <> k.organization_id
UNION ALL
SELECT 'P06d', 'Contacts linked to a supplier of ANOTHER organization (link ignored by the backfill)',
  IF(COUNT(*) = 0, 'PASS', 'REVIEW'), CONCAT(COUNT(*), ' contact(s)')
FROM organization_contacts k JOIN suppliers s ON s.id = k.supplier_id WHERE s.organization_id <> k.organization_id
UNION ALL
SELECT 'P06e', 'Blank names (party display_name would be blank)', IF(SUM(n) = 0, 'PASS', 'REVIEW'),
  CONCAT('customers=', SUM(IF(src = 'c', n, 0)), ' suppliers=', SUM(IF(src = 's', n, 0)), ' contacts=', SUM(IF(src = 'k', n, 0)))
FROM (SELECT 'c' AS src, COUNT(*) AS n FROM customers WHERE TRIM(display_name) = ''
      UNION ALL SELECT 's', COUNT(*) FROM suppliers WHERE TRIM(name) = ''
      UNION ALL SELECT 'k', COUNT(*) FROM organization_contacts WHERE TRIM(full_name) = '') x;

SELECT 'P06f' AS id, 'Customer / supplier same name (kept separate, reported as possible duplicate)' AS check_name, 'INFO' AS result,
  CONCAT(COUNT(*), ' pair(s) (approximation: case-insensitive equality)') AS detail
FROM customers c JOIN suppliers s ON s.organization_id = c.organization_id AND LOWER(TRIM(s.name)) = LOWER(TRIM(c.display_name)) AND c.type = 'company';

SELECT 'P06g' AS id, 'E-mail shared by several legacy rows (never merged; reported)' AS check_name, 'INFO' AS result,
  CONCAT(COUNT(*), ' shared address(es)') AS detail
FROM (SELECT organization_id, LOWER(TRIM(email)) AS e FROM (
        SELECT organization_id, email FROM customers UNION ALL SELECT organization_id, email FROM suppliers
        UNION ALL SELECT organization_id, email FROM organization_contacts) u
      WHERE email IS NOT NULL AND TRIM(email) <> '' GROUP BY organization_id, LOWER(TRIM(email)) HAVING COUNT(*) > 1) d;

-- P07 invoice eligibility change (OPT-FC-004): effective immediately, every company customer may be invoiced
-- BEFORE full payment unless an authorized user pins "after_full_payment" afterwards.
SELECT 'P07a' AS id, 'Company customers that become eligible for invoice-before-payment' AS check_name, 'REVIEW' AS result,
  CONCAT('org ', organization_id, ': ', COUNT(*)) AS detail
FROM customers WHERE type = 'company' GROUP BY organization_id;

SELECT 'P07b' AS id, 'Confirmed, not fully paid Production orders of company customers' AS check_name, 'REVIEW' AS result,
  CONCAT('org ', o.organization_id, ': ', COUNT(*), ' order(s), total_incl_tax=', SUM(o.total_incl_tax)) AS detail
FROM sales_orders o JOIN customers c ON c.id = o.customer_id
WHERE c.type = 'company' AND o.status = 'confirmed' AND o.payment_status <> 'paid' AND o.sandbox_id IS NULL
GROUP BY o.organization_id;

SELECT 'P07c' AS id, 'Existing DRAFT invoices of company customers (could be issued unpaid after release)' AS check_name,
  IF(COUNT(*) = 0, 'PASS', 'REVIEW') AS result,
  CONCAT(COUNT(*), ' draft(s); first ids: ', COALESCE(SUBSTRING_INDEX(GROUP_CONCAT(i.id ORDER BY i.id), ',', 20), '-')) AS detail
FROM invoices i JOIN sales_orders o ON o.id = i.sales_order_id JOIN customers c ON c.id = o.customer_id
WHERE i.status = 'draft' AND i.sandbox_id IS NULL AND c.type = 'company';

-- P08 queue: drain before the cut-over (old job payloads must be consumed by the code that wrote them)
SELECT 'P08a' AS id, 'Jobs waiting or reserved' AS check_name, IF(COUNT(*) = 0, 'PASS', 'REVIEW') AS result,
  CONCAT(COUNT(*), ' job(s), reserved=', COALESCE(SUM(reserved_at IS NOT NULL), 0)) AS detail FROM jobs
UNION ALL
SELECT 'P08b', 'Failed jobs (kept as they are)', IF(COUNT(*) = 0, 'PASS', 'REVIEW'), CONCAT(COUNT(*), ' failed job(s)') FROM failed_jobs;

-- P09 size of the tables that will be altered (CHECK / foreign key additions copy the table and block writes)
SELECT 'P09' AS id, 'Altered tables' AS check_name, 'INFO' AS result,
  CONCAT(table_name, ': ~', table_rows, ' rows, ', ROUND((data_length + index_length) / 1048576, 1), ' MiB') AS detail
FROM information_schema.tables WHERE table_schema = DATABASE() AND table_name IN ('credit_notes', 'customers', 'finance_obligations', 'inventory_balances', 'invoices', 'organization_contacts', 'organizations', 'payment_allocations', 'payment_refunds', 'payments', 'sandbox_inventory_balances', 'sandbox_payment_allocations', 'sandbox_payment_refunds', 'sandbox_payments', 'suppliers')
ORDER BY data_length DESC;

-- P10 long-running transactions / metadata-lock risk at the moment of the check (needs PROCESS privilege to see others)
SELECT 'P10' AS id, 'Open transactions older than 60 s' AS check_name, IF(COUNT(*) = 0, 'PASS', 'REVIEW') AS result,
  CONCAT(COUNT(*), ' transaction(s)') AS detail
FROM information_schema.processlist
WHERE db = DATABASE() AND command <> 'Sleep' AND time > 60 AND id <> CONNECTION_ID();

COMMIT;
