SELECT 'TABLE', 'woocommerce_integrations', COUNT(*), COALESCE(SUM(CRC32(CONCAT_WS(0x1f, IFNULL(`id`, 0x00), IFNULL(`organization_id`, 0x00), IFNULL(`name`, 0x00), IFNULL(`store_url`, 0x00), IFNULL(`consumer_key`, 0x00), IFNULL(`consumer_secret`, 0x00), IFNULL(`default_warehouse_id`, 0x00), IFNULL(`default_store_id`, 0x00), IFNULL(`sync_stock`, 0x00), IFNULL(`prices_include_tax`, 0x00), IFNULL(`brand_source`, 0x00), IFNULL(`brand_taxonomy`, 0x00), IFNULL(`brand_attribute_name`, 0x00), IFNULL(`brand_meta_key`, 0x00), IFNULL(`reference_meta_key`, 0x00), IFNULL(`last_connection_check_at`, 0x00), IFNULL(`last_connection_ok`, 0x00), IFNULL(`last_product_sync_started_at`, 0x00), IFNULL(`last_product_sync_completed_at`, 0x00), IFNULL(`last_product_modified_cursor`, 0x00), IFNULL(`synced_product_count`, 0x00), IFNULL(`created_at`, 0x00), IFNULL(`updated_at`, 0x00)))), 0), COALESCE(BIT_XOR(CRC32(REVERSE(CONCAT_WS(0x1f, IFNULL(`id`, 0x00), IFNULL(`organization_id`, 0x00), IFNULL(`name`, 0x00), IFNULL(`store_url`, 0x00), IFNULL(`consumer_key`, 0x00), IFNULL(`consumer_secret`, 0x00), IFNULL(`default_warehouse_id`, 0x00), IFNULL(`default_store_id`, 0x00), IFNULL(`sync_stock`, 0x00), IFNULL(`prices_include_tax`, 0x00), IFNULL(`brand_source`, 0x00), IFNULL(`brand_taxonomy`, 0x00), IFNULL(`brand_attribute_name`, 0x00), IFNULL(`brand_meta_key`, 0x00), IFNULL(`reference_meta_key`, 0x00), IFNULL(`last_connection_check_at`, 0x00), IFNULL(`last_connection_ok`, 0x00), IFNULL(`last_product_sync_started_at`, 0x00), IFNULL(`last_product_sync_completed_at`, 0x00), IFNULL(`last_product_modified_cursor`, 0x00), IFNULL(`synced_product_count`, 0x00), IFNULL(`created_at`, 0x00), IFNULL(`updated_at`, 0x00))))), 0) FROM `woocommerce_integrations`;
SELECT 'TABLE', 'woocommerce_stock_tasks', COUNT(*), COALESCE(SUM(CRC32(CONCAT_WS(0x1f, IFNULL(`id`, 0x00), IFNULL(`organization_id`, 0x00), IFNULL(`store_id`, 0x00), IFNULL(`product_id`, 0x00), IFNULL(`product_variant_id`, 0x00), IFNULL(`warehouse_id`, 0x00), IFNULL(`woocommerce_integration_id`, 0x00), IFNULL(`quantity_delta`, 0x00), IFNULL(`source_type`, 0x00), IFNULL(`source_id`, 0x00), IFNULL(`source_reference`, 0x00), IFNULL(`reason`, 0x00), IFNULL(`status`, 0x00), IFNULL(`completed_via`, 0x00), IFNULL(`completed_at`, 0x00), IFNULL(`completed_by_user_id`, 0x00), IFNULL(`metadata`, 0x00), IFNULL(`created_at`, 0x00), IFNULL(`updated_at`, 0x00)))), 0), COALESCE(BIT_XOR(CRC32(REVERSE(CONCAT_WS(0x1f, IFNULL(`id`, 0x00), IFNULL(`organization_id`, 0x00), IFNULL(`store_id`, 0x00), IFNULL(`product_id`, 0x00), IFNULL(`product_variant_id`, 0x00), IFNULL(`warehouse_id`, 0x00), IFNULL(`woocommerce_integration_id`, 0x00), IFNULL(`quantity_delta`, 0x00), IFNULL(`source_type`, 0x00), IFNULL(`source_id`, 0x00), IFNULL(`source_reference`, 0x00), IFNULL(`reason`, 0x00), IFNULL(`status`, 0x00), IFNULL(`completed_via`, 0x00), IFNULL(`completed_at`, 0x00), IFNULL(`completed_by_user_id`, 0x00), IFNULL(`metadata`, 0x00), IFNULL(`created_at`, 0x00), IFNULL(`updated_at`, 0x00))))), 0) FROM `woocommerce_stock_tasks`;
SELECT 'TABLE', 'woocommerce_sync_runs', COUNT(*), COALESCE(SUM(CRC32(CONCAT_WS(0x1f, IFNULL(`id`, 0x00), IFNULL(`organization_id`, 0x00), IFNULL(`woocommerce_integration_id`, 0x00), IFNULL(`type`, 0x00), IFNULL(`mode`, 0x00), IFNULL(`status`, 0x00), IFNULL(`phase`, 0x00), IFNULL(`progress`, 0x00), IFNULL(`failure_reason`, 0x00), IFNULL(`failed_during`, 0x00), IFNULL(`started_at`, 0x00), IFNULL(`completed_at`, 0x00), IFNULL(`products_read`, 0x00), IFNULL(`products_created`, 0x00), IFNULL(`products_updated`, 0x00), IFNULL(`products_skipped`, 0x00), IFNULL(`products_failed`, 0x00), IFNULL(`variants_synced`, 0x00), IFNULL(`categories_synced`, 0x00), IFNULL(`stock_adjustments`, 0x00), IFNULL(`api_requests`, 0x00), IFNULL(`rate_limit_hits`, 0x00), IFNULL(`message`, 0x00), IFNULL(`errors`, 0x00), IFNULL(`api_diagnostics`, 0x00), IFNULL(`triggered_by_user_id`, 0x00), IFNULL(`created_at`, 0x00), IFNULL(`updated_at`, 0x00)))), 0), COALESCE(BIT_XOR(CRC32(REVERSE(CONCAT_WS(0x1f, IFNULL(`id`, 0x00), IFNULL(`organization_id`, 0x00), IFNULL(`woocommerce_integration_id`, 0x00), IFNULL(`type`, 0x00), IFNULL(`mode`, 0x00), IFNULL(`status`, 0x00), IFNULL(`phase`, 0x00), IFNULL(`progress`, 0x00), IFNULL(`failure_reason`, 0x00), IFNULL(`failed_during`, 0x00), IFNULL(`started_at`, 0x00), IFNULL(`completed_at`, 0x00), IFNULL(`products_read`, 0x00), IFNULL(`products_created`, 0x00), IFNULL(`products_updated`, 0x00), IFNULL(`products_skipped`, 0x00), IFNULL(`products_failed`, 0x00), IFNULL(`variants_synced`, 0x00), IFNULL(`categories_synced`, 0x00), IFNULL(`stock_adjustments`, 0x00), IFNULL(`api_requests`, 0x00), IFNULL(`rate_limit_hits`, 0x00), IFNULL(`message`, 0x00), IFNULL(`errors`, 0x00), IFNULL(`api_diagnostics`, 0x00), IFNULL(`triggered_by_user_id`, 0x00), IFNULL(`created_at`, 0x00), IFNULL(`updated_at`, 0x00))))), 0) FROM `woocommerce_sync_runs`;

-- Business totals (readable counterpart of the checksums)
SELECT 'TOTAL', 'payments', CONCAT_WS('|', organization_id, status) AS grp, COUNT(*), SUM(amount) FROM `payments` GROUP BY organization_id, status ORDER BY organization_id, status;
SELECT 'TOTAL', 'payment_allocations', CONCAT_WS('|', organization_id) AS grp, COUNT(*), SUM(amount) FROM `payment_allocations` GROUP BY organization_id ORDER BY organization_id;
SELECT 'TOTAL', 'payment_refunds', CONCAT_WS('|', organization_id) AS grp, COUNT(*), SUM(amount) FROM `payment_refunds` GROUP BY organization_id ORDER BY organization_id;
SELECT 'TOTAL', 'sales_orders', CONCAT_WS('|', organization_id, status, payment_status) AS grp, COUNT(*), SUM(total_incl_tax) FROM `sales_orders` GROUP BY organization_id, status, payment_status ORDER BY organization_id, status, payment_status;
SELECT 'TOTAL', 'invoices', CONCAT_WS('|', organization_id, status) AS grp, COUNT(*), SUM(total_incl_tax) FROM `invoices` GROUP BY organization_id, status ORDER BY organization_id, status;
SELECT 'TOTAL', 'credit_notes', CONCAT_WS('|', organization_id, status) AS grp, COUNT(*), SUM(total_incl_tax) FROM `credit_notes` GROUP BY organization_id, status ORDER BY organization_id, status;
SELECT 'TOTAL', 'inventory_balances', CONCAT_WS('|', organization_id) AS grp, COUNT(*), CONCAT(SUM(on_hand), '/', SUM(reserved)) FROM `inventory_balances` GROUP BY organization_id ORDER BY organization_id;
SELECT 'TOTAL', 'finance_obligations', CONCAT_WS('|', organization_id) AS grp, COUNT(*), SUM(planned_amount) FROM `finance_obligations` GROUP BY organization_id ORDER BY organization_id;
SELECT 'TOTAL', 'finance_outgoing_payments', CONCAT_WS('|', organization_id) AS grp, COUNT(*), SUM(amount) FROM `finance_outgoing_payments` GROUP BY organization_id ORDER BY organization_id;

-- Permissions: rows may only be ADDED
SELECT 'PERMISSION', `key` FROM permissions ORDER BY `key`;
SELECT 'GRANT', r.organization_id, r.id, r.slug, p.`key`
FROM role_permission rp JOIN roles r ON r.id = rp.role_id JOIN permissions p ON p.id = rp.permission_id
ORDER BY r.organization_id, r.id, p.`key`;
SELECT 'MIGRATIONS', COUNT(*) FROM migrations;

COMMIT;
