-- =====================================================================================================
-- 10xScale ERP - production-consolidation-01 - DATA INTEGRITY SNAPSHOT (READ ONLY)
--
-- Run twice with application writes stopped: immediately BEFORE and immediately AFTER `artisan migrate`.
--   mysql -N -B --default-character-set=utf8mb4 -h HOST -u USER -p DATABASE < scripts/release/integrity-snapshot.mysql > before.tsv
--   ... migrate ...
--   mysql ... < scripts/release/integrity-snapshot.mysql > after.tsv
--   diff before.tsv after.tsv
--
-- It reads only the tables and columns that exist on main (5285c6c), so new columns / tables never disturb it.
-- EXPECTED differences: only added lines starting with PERMISSION or GRANT, and the MIGRATIONS line.
-- Any changed TABLE or TOTAL line, or any removed ("<") line, is a failure: stop and follow the recovery plan.
-- Excluded as volatile: cache, cache_locks, failed_jobs, job_batches, jobs, sessions, system_health_heartbeats.
-- Output contains aggregates and role/permission names only (no customer data).
-- =====================================================================================================
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
SET SESSION time_zone = '+00:00';
START TRANSACTION WITH CONSISTENT SNAPSHOT, READ ONLY;

